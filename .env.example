# Optional backend development/CI settings. No real credentials belong here.
# Normal desktop use: enter keys through Settings > API keys.
# This file is NOT loaded automatically. Export variables explicitly if needed.
# Existing stored provider keys take precedence over environment fallback.

# Off by default; set to 1 only for deliberate development/CI use.
SKAZ_ALLOW_ENV_KEYS=0

# Leave unused providers empty. Never commit populated copies.
SONIOX_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# The desktop creates its own backend token, port and data directory.
# Do not hard-code those here. Cloud consent/model selection still use Settings.
