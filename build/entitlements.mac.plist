<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Electron ships a JIT and unsigned-in-place helper frameworks; the
         hardened runtime needs these three to launch at all. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- The frozen Python backend is spawned as a child process. -->
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
    <!-- Live capture is the product. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- Soniox and provider APIs are reached over the network. -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- Session files and exports are written to user-chosen folders. -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
  </dict>
</plist>
