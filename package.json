{
  "name": "audiohelper",
  "version": "0.0.0",
  "private": true,
  "description": "Desktop assistant that listens along, transcribes with timestamps, answers about the moment, and keeps notes.",
  "author": "all0b0y <bykov220033@gmail.com>",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:vite": "electron-vite dev",
