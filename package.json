{
  "name": "skaz",
  "version": "0.3.1",
  "private": true,
  "description": "Desktop assistant that listens along, transcribes with timestamps, answers about the moment, and keeps notes.",
  "author": "all0b0y",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:vite": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p electron/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "electron-vite build && playwright test",
    "preview": "electron-vite preview",
    "icon": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/make-icon.mts",
    "build:backend": "backend/.venv/bin/pyinstaller --noconfirm --clean --distpath backend/dist --workpath backend/build/pyinstaller backend/skaz-backend.spec",
    "build:media": "backend/.venv/bin/python scripts/prepare-media-tools.py",
    "dist:mac": "npm run icon && npm run build:media && npm run build:backend && npm run build && electron-builder --mac --config electron-builder.yml"
  },
  "dependencies": {
    "@animateicons/react": "0.12.1",
    "@lezer/markdown": "^1.8.0",
    "katex": "^0.19.0",
    "lucide-react": "^1.61.0",
    "motion": "^14.5.0",
    "pele": "1.8.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.22.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.1.2",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.4"
  }
}
